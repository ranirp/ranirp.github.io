{
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.wordWrap": "on",
  "cSpell.words": [
    "aceternity",
    "aiarticle",
    "Androidstudio",
    "architecting",
    "Epapa",
    "epapalogo",
    "Fastapi",
    "Githubactions",
    "Googlecloud",
    "Nextdotjs",
    "Nodedotjs",
    "Socketdotio",
    "tabler",
    "Testinglibrary",
    "vercel"
  ]
}